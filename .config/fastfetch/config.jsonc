{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "height": 15,
        "width": 30,
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "display": {
        "percent": {
            "type": ["bar"]
        },
        "bar": {
            "width": 10,
            "char": {
                "elapsed": "󰝤",
                "total": "\u001b[90m󰝤"
            },
            "border": {
                "left": "",
                "right": ""
            }
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[90m╭──────────────────────────────Hardware───────────────────────────────╮"
        },
        {
            "type": "custom",
            "format": "\u001b[1;92m󰌢 PC\u001b[0m",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "├   ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "├  󰍹 ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "├   ",
            "keyColor": "green",
            "percent": {
                "type": ["num"]
            }
        },
        {
            "type": "swap",
            "key": "├  󰯍 ",
            "keyColor": "green",
            "percent": {
                "type": ["num"]
            }
        },
        {
            "type": "disk",
            "key": "├  󰋊 ",
            "format": "({mountpoint}): {size-used} [{size-percentage} {size-percentage-bar}] {size-total} - {filesystem}",
            "keyColor": "green",
            "percent": {
                "type": ["bar", "num"]
            }
        },
        {
            "type": "localip",
            "keyColor": "green",
            "key": "├  󰖩 ",
            "showIpv4": true,
            "showIpv6": false,
            "showLoopback": false,
            "showMac": false,
            "compact": true,
            "showPrefixLen": false
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰─────────────────────────────────────────────────────────────────────╯"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╭──────────────────────────────Software───────────────────────────────╮"
        },
        {
            "type": "os",
            "key": " OS",
            "format": "{2}",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "├   ",
            "keyColor": "yellow"
        },

        {
            "type": "packages",
            "key": "├  󰏗 ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "├  󰞷 ",
            "format": "{1}",
            "keyColor": "yellow"
        },
        {
            "type": "de",
            "key": "󰧨 DE",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "├  󱂬 ",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "├  󰉦 ",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰─────────────────────────────────────────────────────────────────────╯"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╭─────────────────────────────Uptime / Age────────────────────────────╮"
        },
        {
            "type": "uptime",
            "key": "├  Uptime  ",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": "├ 󱦟 OS Age  ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰─────────────────────────────────────────────────────────────────────╯"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
